# ts-prune ignore list
#
# ts-prune does not follow `export { x } from './y.ts'` re-export chains, so
# every symbol re-exported through lib/index.ts is reported as unused even
# though it is part of the public API. Most entries below are that class of
# false positive.
#
# The real check is `npm run check:dead`, which recomputes this list and fails
# on any symbol that is neither re-exported nor listed here. Regenerate with:
#   npm run check:dead -- --write
#
# Format: <file>:<exported symbol>

# Intentionally not re-exported from lib/index.ts, but part of the filter
# module's public surface and asserted by tests/unit/readme.claims.test.ts:
# the public alias is `levels`, and `colorlevels` is reachable directly.
lib/filters/video/index.ts:colorlevels

# The value-coercion step of `key=value` parsing, on its own so the battle
# suites can assert the primitive mapping (`true`, `42`, `2.5`, `0x10`) that
# every arg builder depends on. Not part of the package's public surface.
lib/cli/flags.ts:coerceValue
