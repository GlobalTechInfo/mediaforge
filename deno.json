{
  "name": "@globaltech/mediaforge",
  "version": "2.1.0-rc.1",
  "author": "Qasim Ali",
  "license": "MIT",
  "nodeModulesDir": "none",
  "exports": {
    ".": "./lib/index.ts"
  },
  "compilerOptions": {
    "lib": [
      "ES2022",
      "deno.window"
    ]
  },
  "tasks": {
    "test": "deno test --allow-env --allow-run --allow-write --allow-read --allow-sys=uid --ignore=deno-tests/battle.test.ts --ignore=deno-tests/newfeatures.test.ts --ignore=deno-tests/cli.test.ts deno-tests/",
    "test:unit": "deno test --allow-env --allow-run --allow-write --allow-read --allow-sys=uid deno-tests/unit/",
    "test:integration": "deno test --allow-env --allow-run --allow-write --allow-read --allow-sys=uid deno-tests/integration/",
    "check": "deno check lib/ deno-tests/ runtime-tests/",
    "battle": "deno run --allow-env --allow-run --allow-write --allow-read --allow-sys=uid deno-tests/battle.test.ts",
    "battle:new": "deno run --allow-env --allow-run --allow-write --allow-read --allow-sys=uid deno-tests/newfeatures.test.ts",
    "battle:cli": "deno run --allow-env --allow-run --allow-write --allow-read --allow-sys=uid deno-tests/cli.test.ts",
    "battle:runtime": "deno run --allow-env --allow-run --allow-write --allow-read --allow-sys=uid runtime-tests/battle.ts",
    "battle:all": "deno task battle && deno task battle:new && deno task battle:cli && deno task battle:runtime"
  },
  "test": {
    "include": [
      "deno-tests/"
    ],
    "exclude": [
      "**/tmp*/"
    ]
  },
  "check": {
    "include": [
      "lib/",
      "deno-tests/",
      "runtime-tests/"
    ],
    "exclude": [
      "tests/",
      "dist/",
      "node_modules/",
      "**/tmp*/"
    ]
  },
  "lint": {
    "include": [
      "lib/",
      "runtime-tests/"
    ],
    "exclude": [
      "deno-tests",
      "tests/",
      "eslint.config.mjs",
      "node_modules/",
      "dist/"
    ]
  },
  "publish": {
    "include": [
      "lib/**/*.ts",
      "README.md",
      "LICENSE",
      "deno.json"
    ],
    "exclude": [
      "deno-tests",
      "tests/**",
      "dist/**",
      "node_modules/**",
      "runtime-tests/**",
      "scripts/**",
      "battle*.test.ts",
      "ts-prune.ignore"
    ]
  }
}
